AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-local-key

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_API_KEY=replace-with-your-local-key

ALLOWED_ORIGIN=http://localhost:5173

# Nylas sandbox: connect Maya's test mailbox in the dashboard, then copy its grant ID.
NYLAS_API_KEY=replace-with-your-nylas-sandbox-key
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_GRANT_ID=replace-with-maya-grant-id
NYLAS_CLIENT_ID=replace-with-your-nylas-client-id

# Set after running: uv run --locked --no-sync python -m scripts.config_nylas_webhook you@example.com
WEBHOOK_SECRET=replace-with-created-webhook-secret
# Public HTTPS tunnel or deployed backend URL, without a trailing slash.
SERVER_URL=https://replace-with-your-public-url.example
